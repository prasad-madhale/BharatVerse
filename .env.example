# BharatVerse configuration (backend and content pipeline)
# Copy this file to .env and fill in your actual values

# LLM Provider (choose one: gemini, anthropic, openai, groq)
# A local run without LLM_PROVIDER uses gemini. The daily GitHub Actions pipeline sets
# LLM_PROVIDER=anthropic explicitly.
LLM_PROVIDER=gemini

# LLM API Keys (provide the key for your chosen provider)
# Google Gemini (FREE - Recommended for MVP)
GEMINI_API_KEY=your_gemini_api_key_here  # Get from: https://makersuite.google.com/app/apikey

# Anthropic Claude (Paid)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Paid)
# OPENAI_API_KEY=your_openai_api_key_here

# Groq (FREE - Fast inference)
# GROQ_API_KEY=your_groq_api_key_here  # Get from: https://console.groq.com/

# Optional: Override default model
# These are the defaults used when LLM_MODEL is unset (see common/llm_provider.py):
# LLM_MODEL=gemini-2.5-flash  # For Gemini
# LLM_MODEL=claude-sonnet-5  # For Anthropic
# LLM_MODEL=gpt-3.5-turbo  # For OpenAI
# LLM_MODEL=llama-3.3-70b-versatile  # For Groq

# Sign-in is handled by Supabase Auth, so no JWT secret is needed here.

# Application Settings
# Backend requests allowed per client address per minute, per worker process (0 turns the limit off)
RATE_LIMIT_REQUESTS_PER_MINUTE=100
# Log level for the backend and the content pipeline: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Content Storage (Supabase Storage bucket)
ARTICLES_STORAGE_BUCKET=articles
